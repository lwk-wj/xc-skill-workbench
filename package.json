{
  "name": "xc-skills-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && vue-tsc -p tsconfig.web.json --noEmit",
    "typecheck:vue": "vue-tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm build && playwright test",
    "package:mac": "pnpm build && electron-builder --mac dmg zip --arm64"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "dompurify": "3.4.12",
    "element-plus": "^2.14.3",
    "fs-extra": "^11.3.6",
    "marked": "18.0.6",
    "pinia": "^4.0.2",
    "vue": "^3.5.40",
    "xc-skills": "git+https://github.com/lwk-wj/xc-skills.git#73e06c5e24c20ba5b3a52ed0cc1aa1007c119f2f",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/user-event": "14.6.1",
    "@testing-library/vue": "^8.1.0",
    "@types/node": "22.20.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.4.11",
    "electron": "43.1.1",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "jsdom": "28.1.0",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "4.1.10",
    "vue-tsc": "^3.3.7"
  }
}
